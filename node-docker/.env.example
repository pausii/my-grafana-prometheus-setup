# Copy to .env on EACH Docker node. The files in this folder are
# identical on every host; this .env is the only thing that differs.
#   cp .env.example .env

# Where node_exporter listens.
#   On a host with a private link to the hub, bind to that private
#   address only — then port 9100 never exists on a public
#   interface, and the firewall becomes the second layer rather
#   than the only one.
#   On a host without one, use ":9100" and rely on UFW.
LISTEN_ADDR=:9100

# The only source allowed to scrape. The hub's private address if
# there is a private link, otherwise its public one.
#
# Careful: if the hub reaches this host over IPv6, this must be the
# hub's IPv6 address. Allowing its IPv4 has no effect — the packets
# arrive with an IPv6 source and the target stays DOWN while the
# rule looks correct.
ALLOW_FROM=<HUB_IPV4>

# Private network interface, if any. Leave EMPTY when there is
# none; ufw.sh then skips the check instead of refusing to run.
VLAN_IFACE=
