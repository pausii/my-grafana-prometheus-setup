# Copy to .env on EACH systemd node.
#   cp .env.example .env

# Where node_exporter listens. install.sh writes this into
# /etc/default/node_exporter, which the unit reads.
LISTEN_ADDR=:9100

# The only source allowed to scrape.
ALLOW_FROM=<HUB_IPV4>

# SSH port, used when enabling the firewall.
SSH_PORT=22
