# ============================================================
# inventory.env.example — copy to inventory.env and fill in
# ============================================================
#   cp inventory.env.example inventory.env
#
# inventory.env is NOT tracked by git. It holds your
# infrastructure map: addresses, accounts, network paths. The file
# is not itself a credential, but for an attacker it is
# ready-made reconnaissance.
#
# NAMING SCHEME
#   <country>-<dc>-<nn>        e.g. de-fsn-01
#
#   country  ISO two-letter code
#   dc       the provider's own datacenter code (fsn, hel, gra, …)
#   nn       two digits, ALWAYS starting at 01
#
# Start at 01 even when there is only one server in that location.
# A second one always arrives eventually, and renaming a running
# server is far more painful than numbering from the start. Two
# digits so sorting still works past ten.
#
# Lowercase with hyphens: PromQL selectors are case-sensitive, and
# a slash gets URL-encoded in Grafana links.
#
# Ephemeral servers do not use this scheme — they are named after
# their public IP, which is unique without any coordination.

# --- HUB : Prometheus + Grafana + node_exporter
HUB_NAME=de-fsn-01
HUB_IPV4=
HUB_IPV6=
HUB_VLAN=                      # leave empty if there is no private network
HUB_DNS=

# --- NODE B : Docker example
NODE_B_NAME=fi-hel-01
NODE_B_IPV4=
NODE_B_IPV6=
NODE_B_VLAN=

# --- NODE C : Podman example
NODE_C_NAME=fr-gra-01
NODE_C_IPV4=
NODE_C_IPV6=
NODE_C_SSH=

# --- NODE D : binary + systemd example
NODE_D_NAME=de-fra-01
NODE_D_IPV4=
NODE_D_IPV6=

# --- Admin workstation (for SSH firewall rules)
ADMIN_IPV4=

# --- Push endpoint for ephemeral servers
PUSH_DOMAIN=push.example.com
