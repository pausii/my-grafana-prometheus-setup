 "panels": [
  {
   "type": "stat",
   "title": "Servers up",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Number of fixed servers currently scraped successfully.\n\nDeliberately WITHOUT a colour threshold. A \"green if 4\" threshold has to be edited every time a server is added \u2014 and it will be forgotten. The red/green signal already lives in \"Status by location\" next to it, per server, and that never goes stale.",
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "count(up{job=\"node\"} == 1)",
     "legendFormat": "up",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "stat",
   "title": "Status by location",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Green means the last scrape succeeded. Red means Prometheus could not reach the target.",
   "gridPos": {
    "h": 4,
    "w": 9,
    "x": 5,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "up{job=\"node\"}",
     "legendFormat": "{{city}} ({{country}})",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "UP",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "stat",
   "title": "Uptime",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "node_time_seconds - node_boot_time_seconds: how long the host has been running since its last boot.",
   "gridPos": {
    "h": 4,
    "w": 10,
    "x": 14,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "node_time_seconds{job=\"node\"} - node_boot_time_seconds{job=\"node\"}",
     "legendFormat": "{{city}} ({{country}})",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "bargauge",
   "title": "CPU now",
   "description": "Instant value, not a graph. On an overview page the question is \"how is it right now\", not \"what was the history\".",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "100 - (avg without(cpu, mode) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m])) * 100)",
     "legendFormat": "{{city}} ({{country}})",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "showUnfilled": true,
    "minVizWidth": 8,
    "minVizHeight": 16,
    "valueMode": "color",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "bargauge",
   "title": "Memory now",
   "description": "Uses MemAvailable, not MemFree. On Linux MemFree is misleading: it counts reclaimable page cache as used, so it looks alarming when nothing is wrong.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 8,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
     "legendFormat": "{{city}} ({{country}})",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "showUnfilled": true,
    "minVizWidth": 8,
    "minVizHeight": 16,
    "valueMode": "color",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "bargauge",
   "title": "Disk / now",
   "description": "Root partition only. The thresholds are tighter than CPU because a full disk is usually harder to recover from than a busy CPU.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 8,
    "x": 16,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "100 - (node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"} * 100)",
     "legendFormat": "{{city}} ({{country}})",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "showUnfilled": true,
    "minVizWidth": 8,
    "minVizHeight": 16,
    "valueMode": "color",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "timeseries",
   "title": "CPU used (%)",
   "description": "rate() gives the per-second increase of the idle CPU counter; subtracting from 100 yields percent used.\n\nNote `avg without(cpu, mode)` rather than `avg by(instance)`. Both average across cores, but by(instance) DROPS every other label, leaving the {{city}} legend empty. without() removes only the two labels named and keeps the rest.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "100 - (avg without(cpu, mode) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m])) * 100)",
     "legendFormat": "{{city}} ({{country}})",
     "refId": "A",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
