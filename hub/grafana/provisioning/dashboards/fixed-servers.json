  {
   "type": "table",
   "title": "Server inventory",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Shows why the labels are worth having. Because country, city, provider, role and runtime are stored as SEPARATE labels \u2014 rather than merged into one string like 'Germany/Falkenstein' \u2014 each can be filtered and grouped on. For example {provider=\"hetzner\"} or sum by (country) (...).",
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 34
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "up{job=\"node\"}",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "job": true,
       "__name__": true,
       "Value": true
      },
      "indexByName": {
       "server": 0,
       "country": 1,
       "city": 2,
       "provider": 3,
       "role": 4,
       "runtime": 5,
       "instance": 6
      },
      "renameByName": {
       "server": "Server",
       "country": "Country",
       "city": "City",
       "provider": "Provider",
       "role": "Role",
       "runtime": "Runtime",
       "instance": "Instance"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left",
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  }
 ]
